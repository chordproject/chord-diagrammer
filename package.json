{
    "name": "@chordproject/diagrammer",
    "version": "1.1.0",
    "type": "module",
    "module": "dist/index.js",
    "main": "dist/index.cjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./data/guitar.json": "./data/guitar.json"
    },
    "sideEffects": false,
    "files": [
        "dist",
        "data"
    ],
    "description": "A TypeScript library for generating SVG chord diagrams.",
    "engines": {
        "node": ">=20.19.0"
    },
    "keywords": [
        "chordpro",
        "chordproject",
        "viewer",
        "chord",
        "diagrams"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/chordproject/chord-diagrammer"
    },
    "author": "ChordProject (http://chordproject.com)",
    "license": "AGPL-3.0-only",
    "scripts": {
        "dev": "vite demo --port 8082",
        "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean",
        "build:demo": "vite build demo --outDir ../diagrammer-demo-dist",
        "update:guitar-data": "node scripts/generate-guitar-dataset.mjs && npm run test:collection",
        "test:collection": "npm run build && node scripts/test-collection.mjs",
        "suggest:chord-corrections": "npm run build && node scripts/suggest-chord-corrections.mjs",
        "release": "npm run build && npm publish"
    },
    "devDependencies": {
        "jsdom": "^29.1.1",
        "tsup": "^8.3.5",
        "typescript": "^5.8.3",
        "vite": "^6.0.7"
    }
}
