{
    "compilerOptions": {
        "target": "ES2022",
        "sourceMap": true,
        "strict": true,
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "isolatedModules": true,
        "noEmit": true,
        "lib": ["ES2022", "DOM"]
    },
    "include": ["./src/**/*"],
    "exclude": ["node_modules", "**/*.spec.ts"]
}
